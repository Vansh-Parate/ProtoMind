generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Case {
  id              Int        @id @default(autoincrement())
  customer_id     String
  alert_payload   Json
  risk_score      Int
  risk_level      String     @db.VarChar(16)
  typology        String
  triggered_rules Json
  confidence_score Float
  status          String     @db.VarChar(16)
  created_at      DateTime   @default(now())

  sarReports SARReport[]
  auditLogs  AuditLog[]

  @@index([status])
  @@index([risk_level])
}

model SARReport {
  id            Int       @id @default(autoincrement())
  case_id       Int
  generated_text String
  edited_text   String?
  approved_by   String?
  approved_at   DateTime?
  created_at    DateTime  @default(now())

  case Case @relation(fields: [case_id], references: [id])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  case_id        Int
  action         String
  actor          String
  timestamp      DateTime @default(now())
  input_snapshot  Json?
  output_snapshot Json?

  case Case @relation(fields: [case_id], references: [id])

  @@index([case_id])
}

