generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Case {
  id               BigInt     @id @default(autoincrement())
  customer_id      String
  alert_payload    Json
  risk_score       Int
  risk_level       String
  typology         String
  triggered_rules  Json
  confidence_score Float
  status           String
  created_at       DateTime  @default(now())

  sarReports SARReport[]
  auditLogs  AuditLog[]

  @@index([status])
  @@index([risk_level])
}

model SARReport {
  id            BigInt    @id @default(autoincrement())
  case_id       BigInt
  generated_text String
  edited_text   String?
  approved_by   String?
  approved_at   DateTime?
  created_at    DateTime  @default(now())

  case Case @relation(fields: [case_id], references: [id])
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  case_id        BigInt
  action         String
  actor          String
  timestamp      DateTime @default(now())
  input_snapshot  Json?
  output_snapshot Json?

  case Case @relation(fields: [case_id], references: [id])

  @@index([case_id])
}
